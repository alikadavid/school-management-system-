<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBT </title>
    <link rel="stylesheet" href="/test.css">
    <script src="/script.js" defer></script>
</head>
<body>
   <div id="intro">
    <h1 id="header"><%= first_name %>       <%= last_name %></h1>
    <p class="class"><%= student_class %></p>
    <form action="/logout" id="logout" method="post">
      <button class="logoutBtn" type="submit">logout</button>
    </form>
   </div>
   <div id="sidebar">
            <% for (let i = 0; i < subjects.length; i++) { %>
              <form action="/<%= subjects[i] %>" method="get">
                <input type="hidden" name="class" value="<%= student_class %>">
                <input type="hidden" name="subject" value="<%= subjects[i] %>">
                <button type="submit" class="sideBtn"><%= subjects[i].toUpperCase() %></button>
              </form>
                
            <% } %>
    </div>
    <% if (!questions && !report) {%>
      <div id="blank">
        <h3>CLICK TO START TEST</h3>
      </div>
    <% } if (questions) {%>
         <div id="content">
        <div id="main">
          <form action="/submit" method="post">
            <h2><%= subject %></h2>
            <%- questions %>
            <input type="hidden" name="class" value="<%= student_class %>">
            <input type="hidden" name="subject" value="<%= subject %>">
            <div class="submit">
              <button class="submitBtn" type="submit">submit</button>
            </div>
          </form>
        </div>
   </div>
    <% }%>

   <% if (!questions && report) {%>
          <div id="report">
            <h3> <%= report %></h3>
            <h3><%= percentage %></h3>
          </div>
   <% } %>
</body>
</html>